<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HERDR_CONFIG_PATH</key>
		<string>__HOME__/.config/herdr/plugins/config/gamepad/herdr-keys.toml</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>dev.herdr.gamepad</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PLUGIN_ROOT__/bin/herdr-gamepad</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/state/herdr/plugins/gamepad/daemon.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/state/herdr/plugins/gamepad/daemon.log</string>
	<key>WorkingDirectory</key>
	<string>__PLUGIN_ROOT__</string>
</dict>
</plist>
